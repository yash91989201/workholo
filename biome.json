{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/.nx",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!**/src/env.ts",
      "!**/src-tauri",
      "!**/.nuxt",
      "!bts.jsonc",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.alchemy",
      "!**/.svelte-kit",
      "!**/wrangler.jsonc",
      "!**/.source",
      "!**/convex/_generated",
      "!**/.agent",
      "!**/.agents",
      "!**/.claude",
      "!**/.codex",
      "!**/.omp",
      "!**/coverage",
      "!**/.evlog",
      "!apps/docs/.astro",
      "!apps/docs/public"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "info"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      },
      "style": {
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        "useConsistentTypeDefinitions": "off",
        "useConsistentMethodSignatures": "off"
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noBarrelFile": "off",
        "useTopLevelRegex": "off",
        "noNamespaceImport": "off"
      },
      "suspicious": {
        "useAwait": "off",
        "noParametersOnlyUsedInRecursion": "off",
        "noUnnecessaryConditions": "warn"
      },
      "complexity": {},
      "security": {},
      "a11y": {}
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noLeakedRender": "off",
            "noShadow": "off",
            "noArrayIndexKey": "off",
            "noEqualsToNull": "off",
            "noUnnecessaryConditions": "off",
            "noEmptyBlockStatements": "off",
            "noDoubleEquals": "off",
            "noDocumentCookie": "off"
          },
          "correctness": {
            "noNestedComponentDefinitions": "off"
          },
          "style": {
            "noExportedImports": "off",
            "useDestructuring": "off",
            "noNestedTernary": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "useFocusableInteractive": "off",
            "noRedundantRoles": "off",
            "noNoninteractiveTabindex": "off",
            "noNoninteractiveElementInteractions": "off",
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/schema-generator/index.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    }
  ]
}
