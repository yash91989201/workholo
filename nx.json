{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{workspaceRoot}/apps/web/dist/**",
      "!{workspaceRoot}/apps/web/.tanstack/**",
      "!{workspaceRoot}/apps/web/.output/**",
      "!{workspaceRoot}/apps/web/.nitro/**",
      "!{workspaceRoot}/apps/web/src/routeTree.gen.ts",
      "!{workspaceRoot}/apps/native/.expo/**",
      "!{workspaceRoot}/apps/native/dist/**",
      "!{workspaceRoot}/apps/native/web-build/**",
      "!{workspaceRoot}/apps/native/ios/**",
      "!{workspaceRoot}/apps/native/android/**",
      "!{workspaceRoot}/apps/server/dist/**",
      "!{workspaceRoot}/packages/db/dist/**",
      "!{workspaceRoot}/packages/api/dist/**",
      "!{workspaceRoot}/packages/auth/dist/**",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{workspaceRoot}/apps/console/dist/**",
      "!{workspaceRoot}/apps/console/.tanstack/**",
      "!{workspaceRoot}/apps/console/.output/**",
      "!{workspaceRoot}/apps/console/.nitro/**",
      "!{workspaceRoot}/apps/console/src/routeTree.gen.ts",
      "!{workspaceRoot}/apps/agent/dist/**",
      "!{workspaceRoot}/apps/agent/.tanstack/**",
      "!{workspaceRoot}/apps/agent/src/routeTree.gen.ts",
      "!{workspaceRoot}/apps/platform/dist/**",
      "!{workspaceRoot}/apps/platform/.tanstack/**",
      "!{workspaceRoot}/apps/platform/.output/**",
      "!{workspaceRoot}/apps/platform/.nitro/**",
      "!{workspaceRoot}/apps/platform/src/routeTree.gen.ts",
      "!{workspaceRoot}/apps/agent/src-tauri/target/**"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["default", "^default"]
    },
    "dev": {
      "cache": false,
      "continuous": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "continuous": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "continuous": true
    },
    "db:start": {
      "cache": false
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "continuous": true
    },
    "db:down": {
      "cache": false
    }
  },
  "analytics": false
}
